# توکن بازوی پیام‌رسان بله (دریافتی از @BotFather در بله)
BOT_TOKEN=123456789:ABCDEF1234567890abcdef1234567890

# آدرس سرور API بله (پشتیبانی هماهنگ از BALE_API_URL و API_URL)
BALE_API_URL=https://tapi.bale.ai

# شناسه‌های عددی سوپرادمین‌ها (جداشده با کاما)
ADMIN_IDS=111111111,222222222

# منطقه زمانی و تنظیمات پیش‌فرض چله
TIMEZONE=Asia/Tehran
# تعداد روزهای چله (پشتیبانی هماهنگ از CYCLE_DAYS و LEAGUE_DURATION)
CYCLE_DAYS=40
DEFAULT_HALF_COUPONS=5
DEFAULT_ONE_MIN_COUPONS=1
# کف مطالعه پیش‌فرض لیگ به دقیقه (پشتیبانی هماهنگ از DEFAULT_LEAGUE_FLOOR و DEFAULT_FLOOR)
DEFAULT_LEAGUE_FLOOR=10

# آدرس دیتابیس: تولید = PostgreSQL ، توسعه/تست = SQLite
# DATABASE_URL=postgresql://user:password@127.0.0.1:5432/ketabkharsho
DATABASE_URL=sqlite:///./data/ketabkharsho.db
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
# فعال‌سازی بکاپ خودکار PostgreSQL با pg_dump (نیازمند نصب pg_dump روی سرور)
PG_DUMP_ENABLED=false

# ارسال پلکانی پیام‌ها (حدود ۲۰ تا ۳۰ پیام در ثانیه)
BROADCAST_BATCH_SIZE=40
BROADCAST_MSG_DELAY=0.05
BROADCAST_BATCH_PAUSE=1.0
DB_CHUNK_SIZE=500

# مسیر ذخیره‌سازی بکاپ‌ها و گزارش‌های اکسل
BACKUP_DIR=data/backups
REPORTS_DIR=data/reports
